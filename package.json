{
  "name": "nihongo-lab",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "vite preview",
    "lint": "oxlint",
    "format": "oxfmt",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "coverage": "node scripts/coverage-openjlpt.mjs",
    "check": "npm run typecheck && npm test && npm run lint",
    "perf:bundle": "node scripts/perf-bundle.mjs --check",
    "capacity": "node scripts/capacity-report.mjs",
    "test:pwa": "node tests/pwa-browser.mjs",
    "test:images": "node tests/image-download-browser.mjs --dist dist",
    "test:pwa:update": "node tests/pwa-update-browser.mjs",
    "test:pwa:updates": "node tests/build-pwa-fixtures.mjs && node tests/pwa-update-browser.mjs --old-dist dist --dist .cache/pwa-fixtures/next --next-dist .cache/pwa-fixtures/later",
    "test:quality": "node tests/quality-browser.mjs",
    "test:inference": "node tests/quality-browser.mjs --inference",
    "test:srs-layout": "node tests/srs-layout-browser.mjs --dist dist"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "ts-fsrs": "5.4.2"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vite-pwa/assets-generator": "^1.0.4",
    "@vitejs/plugin-react": "6.0.2",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "playwright-core": "1.57.0",
    "typescript": "5.9.3",
    "vite": "8.2.4",
    "vite-plugin-pwa": "^1.3.0"
  },
  "type": "module",
  "overrides": {
    "oxfmt": {
      "tinypool": "2.2.0"
    }
  }
}
